# ═══════════════════════════════════════════════════════════════
# LoteoManager - Variables de entorno
# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA commitear el `.env` con valores reales.
# ═══════════════════════════════════════════════════════════════

# ─── POCKETBASE ────────────────────────────────────────────────
# Versión del binario de PocketBase a descargar en el Dockerfile
PB_VERSION=0.23.0

# Clave para encriptar settings sensibles dentro de PocketBase.
# Generar con: openssl rand -base64 32
PB_ENCRYPTION_KEY=GENERA_UNA_CLAVE_FUERTE_AQUI

# Superuser bootstrap (creado/actualizado automáticamente al iniciar PocketBase)
# El entrypoint del contenedor ejecuta `pocketbase superuser upsert` con estos
# valores en cada arranque. Permite rotar la password cambiando la env var y
# redeployando. Si ambas faltan, el bootstrap se omite con un warning en logs.
# La password debe tener al menos 10 caracteres o el contenedor falla al arrancar.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=cambiame-en-deploy-real

# URL pública del backend PocketBase desde el browser del admin SPA.
# El entrypoint del contenedor admin-web inyecta este valor en
# /usr/share/nginx/html/env.js → window.__env.POCKETBASE_URL al arrancar,
# así una misma imagen sirve dev y cualquier deploy sin rebuild.
#   - Dev local:    http://localhost:8080
#   - Dokploy:      https://pb.tu-dominio.com  (hostname del Cloudflare Tunnel)
#   - Self-hosted:  http://<host>:6101         (puerto host del compose dokploy)
# Importante: tiene que ser alcanzable desde el navegador del usuario final,
# no desde el contenedor. Para el SSR de landing usar PB_INTERNAL_URL aparte.
POCKETBASE_PUBLIC_URL=http://localhost:8080

# ─── USER DE SERVICIO PARA SSR LANDING ─────────────────────────
# El SSR se loguea con este user para consultar comparativas y crear leads.
# Crear este user en PocketBase con role=admin (o un role custom limitado).
# Debe coincidir EXACTO con el email del user creado en PocketBase (Collections → users).
# Local ej: landing-ssr@interno.local — en prod usar el email real del user SSR (Dokploy).
PB_SERVICE_USER=landing-ssr@interno.local
PB_SERVICE_PASSWORD=GENERA_UNA_PASSWORD_FUERTE_AQUI

# ─── URLS PÚBLICAS ─────────────────────────────────────────────
# UNA sola vez. Sin slash final.
# Landing / links de comparativas (/c/:token). NO es PocketBase.
# Bien:  https://loteoweb.ignaciothompson.com
# Mal:   POCKETBASE_PUBLIC_URL=https://loteopb...  (si aparece dos veces, gana la última)
PUBLIC_BASE_URL=https://www.tu-dominio.com

# Nombre comercial que aparece en la landing pública.
INMOBILIARIA_NOMBRE=Mi Inmobiliaria

# ─── CLOUDFLARE TURNSTILE (anti-spam) ──────────────────────────
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=TU_SITE_KEY_AQUI
TURNSTILE_SECRET_KEY=TU_SECRET_KEY_AQUI

# ─── CLOUDFLARE TUNNEL ─────────────────────────────────────────
# Token del Tunnel. Obtener en:
# https://one.dash.cloudflare.com → Networks → Tunnels → tu tunnel → connect
CLOUDFLARE_TUNNEL_TOKEN=TU_TUNNEL_TOKEN_AQUI

# ─── BACKUPS (Backblaze B2, opcional, para producción) ─────────
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=loteomanager-backups
