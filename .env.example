# ═══════════════════════════════════════════════════════════════
# LoteoManager - Variables de entorno
# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA commitear el `.env` con valores reales.
# ═══════════════════════════════════════════════════════════════

# ─── POCKETBASE ────────────────────────────────────────────────
# Versión del binario de PocketBase a descargar en el Dockerfile
PB_VERSION=0.23.0

# Clave para encriptar settings sensibles dentro de PocketBase.
# Generar con: openssl rand -base64 32
PB_ENCRYPTION_KEY=GENERA_UNA_CLAVE_FUERTE_AQUI

# ─── USER DE SERVICIO PARA SSR LANDING ─────────────────────────
# El SSR se loguea con este user para consultar comparativas y crear leads.
# Crear este user en PocketBase con role=admin (o un role custom limitado).
PB_SERVICE_USER=landing-ssr@interno.local
PB_SERVICE_PASSWORD=GENERA_UNA_PASSWORD_FUERTE_AQUI

# ─── URLS PÚBLICAS ─────────────────────────────────────────────
# URL pública de la landing (sin trailing slash). Usada por:
#   - El generador de PDF (Playwright navega a esta URL).
#   - Meta tags de Open Graph.
#   - El robots.txt y sitemap.xml.
PUBLIC_BASE_URL=https://www.tu-dominio.com

# Nombre comercial que aparece en la landing pública.
INMOBILIARIA_NOMBRE=Mi Inmobiliaria

# ─── CLOUDFLARE TURNSTILE (anti-spam) ──────────────────────────
# Obtener en: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=TU_SITE_KEY_AQUI
TURNSTILE_SECRET_KEY=TU_SECRET_KEY_AQUI

# ─── CLOUDFLARE TUNNEL ─────────────────────────────────────────
# Token del Tunnel. Obtener en:
# https://one.dash.cloudflare.com → Networks → Tunnels → tu tunnel → connect
CLOUDFLARE_TUNNEL_TOKEN=TU_TUNNEL_TOKEN_AQUI

# ─── BACKUPS (Backblaze B2, opcional, para producción) ─────────
# B2_KEY_ID=
# B2_APP_KEY=
# B2_BUCKET=loteomanager-backups
